# Postgres connection string from Neon (pooled runtime URL is fine).
DATABASE_URL=postgres://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Groq. Primary model falls back to GROQ_FALLBACK_MODEL after 429s.
# https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Google AI Studio. https://aistudio.google.com/apikey
# gemini-2.0-flash is retired and gemini-2.5-flash is deprecated.
# Flash-Lite is the default because it thinks at MINIMAL and finishes tool calls
# inside a Vercel Hobby request. 3.8 Flash is the fallback and is pinned to LOW
# thinking (it rejects MINIMAL). Leave GEMINI_THINKING_LEVEL unset unless you
# want to override that.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=

# Daily run caps. A cached repeat of the same spec and tasks does not count.
RATE_LIMIT_PER_IP_DAILY=8
RATE_LIMIT_GLOBAL_DAILY=200
RATE_LIMIT_SALT=change-me

# Upload and agent bounds.
MAX_SPEC_BYTES=1500000
MAX_OPERATIONS=40
MAX_AGENT_STEPS=6
# Whole task budget, checked between model calls.
TASK_TIMEOUT_MS=40000
# One model call, including a retry and a fallback. Must stay under TASK_TIMEOUT_MS.
STEP_TIMEOUT_MS=18000

# Required for /stats when you want it locked, and required for POST /api/admin/gallery/seed.
ADMIN_TOKEN=

# Public site origin used for Open Graph links. Set this on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 only to force the labeled stub agent. Never enable this on a public deploy.
ALLOW_STUB_LLM=
